# Copiá este archivo a apps/web/.env.local y apps/bot/.env

# --- Firebase (opcional: sin esto Lía corre en modo demo) ---
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# Misma API key en el bot para verificar idToken de Google (obligatorio en prod si usás Google)
FIREBASE_WEB_API_KEY=

# --- WhatsApp Cloud API (Meta) ---
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_VERIFY_TOKEN=lia-verify
WHATSAPP_APP_SECRET=

# URL pública del webhook (ngrok / Cloud Run)
BOT_PUBLIC_URL=http://localhost:8787
PORT=8787
LIA_BOT_SECRET=
META_APP_SECRET=

# Mercado Pago (Access Token de la app Suscripciones)
MP_ACCESS_TOKEN=
# Clave secreta del webhook (Notificaciones → revelar)
MP_WEBHOOK_SECRET=
MP_CHECKOUT_SELF_URL=
MP_CHECKOUT_SETUP_URL=
# En producción exigir firma Meta
REQUIRE_META_SIGNATURE=true

# --- Auth OTP (Fase A) ---
# Resend: https://resend.com → API Keys
RESEND_API_KEY=
# Remitente (dominio verificado en Resend). Dev: onboarding@resend.dev
EMAIL_FROM=Lía <onboarding@resend.dev>
# Sin Resend: loguea el código en el bot (solo local). En producción: false + RESEND_API_KEY
EMAIL_DEV_MODE=false
# Admins (emails separados por coma)
ADMIN_EMAILS=