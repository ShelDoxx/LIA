{
  "name": "@lia/bot",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc --noEmit && esbuild src/index.ts --bundle --platform=node --format=esm --outfile=dist/index.js --external:express --external:pdf-lib",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "@lia/nlu": "*",
    "express": "^5.1.0",
    "pdf-lib": "^1.17.1"
  },
  "devDependencies": {
    "esbuild": "^0.25.8",
    "@types/express": "^5.0.3",
    "@types/node": "^24.0.10",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3"
  }
}
